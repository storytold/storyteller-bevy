{
  "name": "studio",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "./studio/src",
  "namedInputs": {
    "assets": ["{projectRoot}/assets/**/*"]
  },
  "targets": {
    "build": {
      "executor": "@nxrs/cargo:build",
      "inputs": ["assets"],
      "options": {
        "release": false
      },
      "configurations": {
        "production": {
          "release": true
        }
      }
    },
    "build:web": {
      "executor": "nx:run-commands",
      "inputs": ["assets"],
      "options": {
        "command": "node scripts/build-web.mjs",
        "cwd": "studio"
      }
    },
    "dev": {
      "executor": "@nxrs/cargo:run",
      "options": {
        "profile": "dev-custom",
        "bin": "studio-standalone"
      }
    },
    "test": {
      "executor": "@nxrs/cargo:test",
      "options": {}
    },
    "lint": {
      "executor": "@nxrs/cargo:clippy",
      "options": {
        "fix": false,
        "failOnWarnings": true,
        "noDeps": true
      }
    }
  },
  "tags": []
}
